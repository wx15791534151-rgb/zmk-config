/*
 * leftpad 键位表
 *
 * bindings 的顺序 = 矩阵扫描顺序：先第 0 行从左到右，再第 1 行……
 * 所以第 1 个是 RC(0,0)，第 6 个是 RC(1,1)，以此类推。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* 第 0 层：日常快捷键 */
        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC      &kp F1        &kp F2        &kp F3
                &kp LC(C)    &kp LC(V)     &kp LC(X)     &kp LC(Z)
                &kp LC(A)    &kp LC(S)     &kp LC(F)     &kp LC(P)
                &mo 1        &kp C_PP      &kp C_MUTE    &kp C_VOL_UP
            >;
        };

        /* 第 1 层：按住左下角那个键时生效（方向键 + 媒体 + 蓝牙） */
        fn_layer {
            display-name = "Fn";
            bindings = <
                &kp UP       &kp DOWN      &kp LEFT      &kp RIGHT
                &kp HOME     &kp END       &kp PG_UP     &kp PG_DN
                &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_CLR    &kp C_VOL_DN
                &trans       &kp C_NEXT    &kp C_PREV    &kp C_VOL_UP
            >;
        };
    };
};
